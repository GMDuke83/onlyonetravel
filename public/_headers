# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML must never be served from a long-lived cache during development,
# otherwise an old page keeps pointing at an old asset.
/
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff

# CSS and JS are not fingerprinted yet — revalidate on every load.
/css/*
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate

# The hero video carries its version in the filename (…-v1.mp4), so a long
# cache is safe: publishing a new cut means publishing a new filename.
/video/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes

/images/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
