{
  "name": "onlyone-luxury-travel",
  "version": "0.1.0",
  "private": true,
  "description": "ONLYONE LUXURY TRAVEL — mobile-first cinematic luxury travel experience.",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "start": "node scripts/dev-server.js",
    "build": "echo \"No build step — 'public/' is deployed as-is.\" && exit 0",
    "stamp": "node scripts/stamp-build.js",
    "stamp:check": "node scripts/stamp-build.js --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/stamp-build.js && playwright test",
    "build:demo": "node scripts/build-demo.js",
    "test:demo": "node scripts/build-demo.js && playwright test -c playwright.demo.config.cjs",
    "dev:backend": "wrangler pages dev public --port 8791",
    "db:migrate:local": "wrangler d1 migrations apply onlyone-travel --local",
    "check:functions": "wrangler pages functions build --outdir .wrangler/functions-build",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.63.0",
    "wrangler": "^4.134.0"
  }
}
