{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onlyone-luxury-travel",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-09-18",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "onlyone-travel",
    // Replace with the ID returned by wrangler d1 create before deployment.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "env": {"preview": {"d1_databases": [{"binding": "DB", "database_name": "onlyone-travel-preview", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}]}}
}
